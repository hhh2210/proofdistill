+omit [DecidableEq σ] [DecidablePred fs] in
+private theorem isF_monomial_of {d : σ →₀ ℕ} (hd : ∀ v, d v ≠ 0 → fs v) (a : K) :
+    IsF fs (monomial d a) := by
