+theorem isF_monomial_frst (m : σ →₀ ℕ) (a : K) : IsF fs (monomial (frst fs m) a) :=
+  isF_monomial_of fs (frst_isF fs m) a

 theorem monomial_split (m : σ →₀ ℕ) (a : K) :
     monomial m a = monomial (frst fs m) a * monomial (ltr fs m) 1 := by
   rw [MvPolynomial.monomial_mul_monomial, frst_add_ltr, mul_one]
+
+/-- A monomial splits into factors on complementary variable sets; equality on these
+products therefore determines a linear map on the entire polynomial ring. -/
+private theorem agree_on_products (A B : MvPolynomial σ K →ₗ[K] MvPolynomial σ K)
+    (h : ∀ g q, IsF fs g → IsL fs q → A (g * q) = B (g * q)) (x : MvPolynomial σ K) :
+    A x = B x := by
+  induction x using MvPolynomial.induction_on' with
+  | monomial m a =>
+    rw [monomial_split fs m a]
+    exact h _ _ (isF_monomial_frst fs m a) (isL_monomial_ltr fs m 1)
+  | add x y hx hy => simp only [map_add (f := _), hx, hy]

